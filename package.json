{
    "name": "admin-ui",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint src --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "generate-types": "openapi-typescript openapi.yaml -o src/generated/types.ts",
        "test:unit": "vitest run",
        "test:e2e": "playwright test",
        "test": "npm run test:unit && npm run test:e2e",
        "oxlint": "oxlint src",
        "prepare": "husky"
    },
    "dependencies": {
        "@mdi/font": "^7.4.47",
        "pinia": "^2.1.7",
        "vue": "^3.4.0",
        "vue-router": "^4.3.0",
        "vuedraggable": "^4.1.0",
        "vuetify": "^3.12.8"
    },
    "devDependencies": {
        "@playwright/test": "^1.61.1",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vitest/coverage-v8": "^4.1.10",
        "@vue/test-utils": "^2.4.11",
        "eslint": "^8.56.0",
        "eslint-plugin-vue": "^10.10.0",
        "husky": "^9.1.7",
        "jsdom": "^29.1.1",
        "lint-staged": "^17.3.0",
        "openapi-typescript": "^7.13.0",
        "oxlint": "^1.77.0",
        "playwright": "^1.61.1",
        "prettier": "^3.2.5",
        "vite": "^8.1.0",
        "vitest": "^4.1.9",
        "vue-eslint-parser": "^10.4.1"
    },
    "allowScripts": {
        "vue-demi@0.14.10": true
    },
    "lint-staged": {
        "*.{js,vue}": [
            "oxlint",
            "eslint --fix"
        ],
        "*.{js,vue,json,css,md,yml,yaml}": [
            "prettier --write"
        ]
    }
}
